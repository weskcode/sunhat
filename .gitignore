# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## macOS
.DS_Store

## User settings
xcuserdata/

## DerivedData
DerivedData/

## Xcode user state
*.xcuserstate
*.xcscmblueprint
*.xcresult

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.swiftpm/
.build/

# Carthage
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Python
__pycache__/
*.pyc

# Environment / secrets
.env
.env.*
*.p8
*.p12
*.mobileprovision

