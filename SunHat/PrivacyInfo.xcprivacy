<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- True because the app requests App Tracking Transparency for AdMob
	     advertising when the user is not Ad-Free.

	     Google does not publish an official NSPrivacyTrackingDomains list for
	     AdMob (confirmed 2026-09-21: the Google Mobile Ads SDK team said as
	     much on their own developer forum, and the shipped GoogleMobileAds
	     12.14.0 / UserMessagingPlatform 3.1.0 xcframeworks declare neither
	     NSPrivacyTracking nor NSPrivacyTrackingDomains themselves — this file
	     is the app's only tracking declaration). The domains below are
	     Google's own documented ad-serving/ad-cookie domains
	     (business.safety.google/adscookies), narrowed to the ones AdMob
	     banner ads actually use — SunHat has no Firebase/Analytics/YouTube
	     SDKs, so those Google properties are excluded. Revisit if the ad
	     stack changes. See docs/MONETIZATION_GOLIVE.md. -->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array>
		<string>googlesyndication.com</string>
		<string>googleadservices.com</string>
		<string>doubleclick.net</string>
		<string>google.com</string>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
