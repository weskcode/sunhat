      }
    },
    "We only access your location to provide relevant weather information. Coordinates are sent only to enabled weather providers to fetch forecasts for your area.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo accedemos a tu ubicación para ofrecerte información del clima relevante. Las coordenadas se envían únicamente a los proveedores de clima activados para obtener pronósticos de tu zona."
          }
        }
      }
    },
    "We respond to privacy inquiries within 30 days, as required by GDPR and CCPA.": {
