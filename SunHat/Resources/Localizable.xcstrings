        }
      }
    },
    "This controls how forecasts and weather conditions appear. You can change it later in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto controla cómo aparecen los pronósticos y las condiciones climáticas. Puedes cambiarlo luego en Ajustes."
          }
        }
      }
    },
    "This export is provided to comply with GDPR Article 20 (Right to Data Portability) and CCPA requirements.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exportación se proporciona para cumplir con el GDPR Article 20 (derecho a la portabilidad de datos) y los requisitos del CCPA."
          }
        }
      }
    },
    "This is how your %@ notifications will appear": {
      "comment": "Body of a sample notification; 'type' is a reminder category name such as Exercise or Gardening",
