          }
        }
      }
    },
    "This permanently removes your reminders, preferences, saved locations, and cached weather data from this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tus recordatorios, preferencias, ubicaciones guardadas y datos meteorológicos en caché de este dispositivo."
