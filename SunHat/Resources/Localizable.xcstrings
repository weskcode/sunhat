    "Privacy Inquiry - SunHat App": {
      "comment": "Pre-filled subject line of the privacy-request email the app composes",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta de privacidad - App SunHat"
          }
        }
      }
    },
    "Privacy Inquiry Type: %@\n%@\nYour Inquiry:\n%@\n\nContact Information:\nEmail: %@\n\nApp Information:\n- App: SunHat\n- Version: %@ (%@)\n- Platform: iOS\n- Date: %@\n\nThank you for contacting our Data Protection Officer. We will respond within 30 days as required by law.": {
      "comment": "Pre-filled body of the GDPR/CCPA privacy-request email the app composes; keep the field labels (Privacy Inquiry Type, Your Inquiry, Contact Information, Email, App Information, App, Version, Platform, Date) and the '- ' bullet formatting",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Privacy Inquiry Type: %1$@\n%2$@\nYour Inquiry:\n%3$@\n\nContact Information:\nEmail: %4$@\n\nApp Information:\n- App: SunHat\n- Version: %5$@ (%6$@)\n- Platform: iOS\n- Date: %7$@\n\nThank you for contacting our Data Protection Officer. We will respond within 30 days as required by law."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de consulta de privacidad: %@\n%@\nTu consulta:\n%@\n\nInformación de contacto:\nCorreo: %@\n\nInformación de la app:\n- App: SunHat\n- Versión: %@ (%@)\n- Plataforma: iOS\n- Fecha: %@\n\nGracias por contactar a nuestro Delegado de Protección de Datos. Responderemos dentro de 30 días según lo exige la ley."
          }
        }
      }
    },
