    "NSLocationAccuracyAuthorizationDescription": {
      "comment": "Privacy - Location Accuracy Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat requires precise location to provide accurate weather-based reminders for your exact location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat necesita tu ubicación precisa para ofrecer recordatorios del clima exactos para tu ubicación."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Privacy - Location Always and When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat needs location access to provide weather-based reminders and background updates for your locations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat necesita acceso a la ubicación para ofrecer recordatorios del clima y actualizaciones en segundo plano para tus ubicaciones."
          }
        }
      }
    },
    "NSLocationTemporaryUsageDescriptionDictionary.WeatherReminderAccuracy": {
      "comment": "Privacy - Location Temporary Usage Description Dictionary - WeatherReminderAccuracy purpose key",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat uses precise location temporarily to match weather forecasts to your current area for accurate reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat usa tu ubicación precisa de forma temporal para ajustar los pronósticos del clima a tu área actual y darte recordatorios exactos."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat needs location access to provide weather-based reminders for your current area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SunHat necesita acceso a la ubicación para ofrecer recordatorios del clima de tu área actual."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "comment": "Privacy - Tracking Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This allows SunHat to show more relevant ads, which helps keep the free version free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto permite que SunHat muestre anuncios más relevantes, lo que ayuda a mantener gratuita la versión gratuita."
          }
        }
      }
